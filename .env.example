# Express API
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string (replace the password and create the database)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/motorvibe

# Authentication (replace with a long random value)
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# MQTT broker for real ESP32 hardware telemetry
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=motorvibe/+/telemetry

# Simulation telemetry interval, in milliseconds
SIMULATION_INTERVAL_MS=1000
